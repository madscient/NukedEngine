; NukedEngineApi.def
; MSVC エクスポート定義ファイル。
; FmEngineApi 仕様 (FMEngineTest docs/FmEngineApi.md) の必須シンボルと、部位ごとのゲインの
; 4 シンボルを載せる。外部メモリのシンボルは載せない (NukedEngine のチップは外部メモリを持たない)。

LIBRARY NukedEngineApi

EXPORTS
    FmEngine_Create
    FmEngine_Destroy
    FmEngine_Inquiry
    FmEngine_GetSupportedChip
    FmEngine_AddChip
    FmEngine_GetChipName
    FmEngine_GetNativeRate
    FmEngine_GetSampleRate
    FmEngine_Write
    FmEngine_SetGain
    FmEngine_GetGain
    FmEngine_GetPartCount
    FmEngine_GetPartName
    FmEngine_SetPartGain
    FmEngine_GetPartGain
    FmEngine_Generate
